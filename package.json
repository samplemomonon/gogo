{
  "name": "gogo",
  "private": true,
  "type": "module",
  "scripts": {
    "design-system:tokens": "bun design-system/web/build.mjs",
    "css:build": "npm run design-system:tokens && tailwindcss -i ./apps/web/internal/shared/web/assets/css/app.css -o ./apps/web/internal/shared/web/assets/css/output.css",
    "css:watch": "npm run design-system:tokens && tailwindcss -i ./apps/web/internal/shared/web/assets/css/app.css -o ./apps/web/internal/shared/web/assets/css/output.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3"
  },
  "dependencies": {
    "daisyui": "^5.7.42",
    "tailwindcss": "^4.3.3"
  }
}
