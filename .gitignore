# ---- Go ----
# Compiled binaries and build output
/bin/
# Stray binaries built at the repo root instead of bin/ (never commit these)
/catalog
/server
/coverage/  # from `make clean` (test coverage reports)

# ---- Templ (a-h/templ) ----
# *_templ.go are generated by `templ generate` (or `make templ`)
# and should not be committed.
*_templ.go

# ---- Tailwind CSS ----
# output.css is generated by `bun run css:build` (or `make css`)
internal/shared/web/assets/css/output.css

# ---- Node / Bun ----
node_modules/
# Rspress output for the customer legal site (docs/site)
docs/site/doc_build/

# ---- devenv (Nix dev environment) ----
# .devenv/state is a Go module cache plus a built store closure. It is
# regenerated by `devenv shell`, and it is large: two of them were 675 MB,
# which is 92% of this working tree's disk. It is not source.
.devenv/
.nix-devenv

# ---- Environment ----
# Keep .env.example; ignore real env files (may contain secrets)
.env
.env.*
!.env.example

# ---- Logs & temp files ----
*.log
*.tmp
tmp/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ---- Agent & tool state ----
# Local agent/tooling state — never project content, and never shared.
# .devenv/ is 675 MB of Nix/Go module cache; .codegraph is a symlink into a
# per-user cache directory, which is meaningless on anyone else's machine.
.omo/
.agents/
.codegraph

# Local debug binaries built at the repo root while inspecting renders
/renderdump
# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml
