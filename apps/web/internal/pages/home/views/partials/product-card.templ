package partials

import (
	"gogo/internal/pages/home/application/results"
	"gogo/internal/shared/money"
	"gogo.design/system/web/ui"
)

templ ProductCard(product *results.Product) {
	<article class={ ui.CardHoverClass + " overflow-hidden flex flex-col justify-between" }>
		@ui.MediaTile("") {
			<div class="size-11 rounded-xl bg-base-100/80 border border-base-300/60 shadow-xs flex items-center justify-center text-primary/80 group-hover:scale-110 group-hover:text-primary transition-[transform,color] duration-200">
				@ui.IconTag("size-5")
			</div>
			@ui.Badge("ghost", "xs", "absolute top-2.5 end-2.5 font-mono text-[10px] text-base-content/50 uppercase tracking-wider") {
				Katalog
			}
		}

		@ui.CardBody("gap-3 p-4 flex-1 flex flex-col justify-between") {
			<div class="space-y-2">
				<h2 class="card-title text-base font-semibold leading-snug group-hover:text-primary transition-colors line-clamp-2">
					{ product.Name }
				</h2>
				<div class="flex items-center justify-between gap-2 pt-0.5">
					@ui.CountBadge(ui.CountBadgeOptions{
						Count:     product.Stock,
						Suffix:    "tersedia",
						ZeroLabel: "Stok habis",
						Class:     "shrink-0",
					})
				</div>
			</div>

			<div class="pt-2 border-t border-base-300/30">
				@ui.PriceBlock("Rp", money.Rupiah(product.Price), ui.PriceSm)

				@ui.CardActions("justify-end pt-3") {
					@ui.ButtonLink("/catalog/"+product.ID, ui.TapActionClass(ui.IntentPrimary, "sm")+" w-full", nil) {
						@ui.IconEye("size-4")
						Lihat detail
					}
				}
			</div>
		}
	</article>
}
