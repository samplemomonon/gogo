package partials

import (
	"gogo/internal/pages/home/application/results"
	"gogo/internal/shared/web/pagekit"
)

// ProductListing is the storefront's listing region: the product grid plus
// crawlable pagination controls when the listing spans more than one page.
// It is what the home page's island renders, for both the full page and the
// HTMX fragment.
templ ProductListing(products []*results.Product, nav pagekit.Pagination) {
	@ProductList(products, nav.Term)

	if nav.HasPrev || nav.HasNext {
		@PaginationNav(nav)
	}
}
