package pages

import (
	"strconv"

	"gogo/internal/shared/web/navigation"
	"gogo/internal/shared/web/shell/layouts"
	"gogo.design/system/web/ui"
)

templ Home(region templ.Component, count int, term string) {
	@ui.PageShell(ui.PageShellOptions{
		Layout: layouts.Base("Gogo — Beranda", navigation.NavFromContext(ctx), navigation.PathFromContext(ctx), term),
	}) {
		@ui.PageHero("Beranda", "primary", "Jelajahi Produk", "Produk diambil dari modul katalog melalui kontrak gRPC catalog.v1.", ui.IconDocuments("size-4")) {
			@ui.StatTile("Produk", strconv.Itoa(count))
			@ui.ButtonLink("/seller/produk", ui.TapActionClass(ui.IntentPrimary, "sm"), nil) {
				@ui.IconDocument("size-4")
				Manage
			}
		}

		@StorefrontPromo(count)
		@Banner(bannerFromContext(ctx))
		@CategoryShortcuts()
		@region
	}
}

templ StorefrontPromo(count int) {
	<section class="relative isolate overflow-hidden rounded-3xl bg-gradient-to-br from-primary via-primary to-secondary px-6 py-8 text-primary-content shadow-lg sm:px-10 sm:py-12" aria-labelledby="storefront-promo-title">
		<div class="pointer-events-none absolute -right-16 -top-24 size-72 rounded-full border-[36px] border-white/10"></div>
		<div class="pointer-events-none absolute right-24 -bottom-28 size-56 rounded-full bg-white/10 blur-2xl"></div>
		<div class="relative z-10 max-w-2xl">
			<span class="inline-flex rounded-full bg-white/15 px-3 py-1 text-xs font-semibold tracking-wide">TEMUKAN PILIHANMU</span>
			<h2 id="storefront-promo-title" class="mt-4 max-w-xl text-3xl font-bold tracking-tight sm:text-4xl">Belanja kebutuhanmu, semua ada di satu tempat</h2>
			<p class="mt-3 max-w-lg text-sm leading-relaxed text-primary-content/80 sm:text-base">Jelajahi produk pilihan dari katalog Gogo dan temukan yang tepat untukmu.</p>
			<a href="#product-list" class="mt-6 inline-flex min-h-11 items-center rounded-xl bg-white px-5 py-2.5 text-sm font-semibold text-primary shadow-sm transition hover:bg-white/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Lihat { strconv.Itoa(count) } produk</a>
		</div>
		<div class="pointer-events-none absolute bottom-7 right-8 hidden h-44 w-56 rotate-6 items-center justify-center rounded-3xl border border-white/20 bg-white/10 shadow-2xl backdrop-blur-sm md:flex">
			<div class="flex size-24 items-center justify-center rounded-2xl bg-white/15">
				@ui.IconTag("size-12 text-white")
			</div>
			<div class="absolute -left-9 top-7 flex size-16 -rotate-12 items-center justify-center rounded-2xl bg-white text-primary shadow-lg">
				@ui.IconCart("size-8")
			</div>
		</div>
	</section>
}

templ CategoryShortcuts() {
	<section aria-labelledby="category-shortcuts-title" class="space-y-4">
		<div class="flex items-end justify-between gap-4">
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Jelajahi</p>
				<h2 id="category-shortcuts-title" class="mt-1 text-xl font-bold tracking-tight sm:text-2xl">Kategori pilihan</h2>
			</div>
			<a href="#product-list" class="text-sm font-semibold text-primary hover:underline">Lihat semua</a>
		</div>
		<nav aria-label="Kategori produk" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
			<a href="/?q=elektronik" class="group flex min-h-24 items-center gap-3 rounded-2xl border border-base-300/70 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md">
				<span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary transition group-hover:bg-primary group-hover:text-primary-content">@ui.IconLayers("size-5")</span>
				<span class="text-sm font-semibold">Elektronik</span>
			</a>
			<a href="/?q=fashion" class="group flex min-h-24 items-center gap-3 rounded-2xl border border-base-300/70 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md">
				<span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-secondary/10 text-secondary transition group-hover:bg-secondary group-hover:text-secondary-content">@ui.IconTag("size-5")</span>
				<span class="text-sm font-semibold">Fashion</span>
			</a>
			<a href="/?q=makanan" class="group flex min-h-24 items-center gap-3 rounded-2xl border border-base-300/70 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md">
				<span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent transition group-hover:bg-accent group-hover:text-accent-content">@ui.IconCart("size-5")</span>
				<span class="text-sm font-semibold">Makanan</span>
			</a>
			<a href="/?q=rumah" class="group flex min-h-24 items-center gap-3 rounded-2xl border border-base-300/70 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md">
				<span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-info/10 text-info transition group-hover:bg-info group-hover:text-info-content">@ui.IconHome("size-5")</span>
				<span class="text-sm font-semibold">Rumah</span>
			</a>
			<a href="/?q=olahraga" class="group flex min-h-24 items-center gap-3 rounded-2xl border border-base-300/70 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md">
				<span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-success/10 text-success transition group-hover:bg-success group-hover:text-success-content">@ui.IconCheckBadge("size-5")</span>
				<span class="text-sm font-semibold">Olahraga</span>
			</a>
			<a href="/?q=kecantikan" class="group flex min-h-24 items-center gap-3 rounded-2xl border border-base-300/70 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md">
				<span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-warning/10 text-warning transition group-hover:bg-warning group-hover:text-warning-content">@ui.IconStore("size-5")</span>
				<span class="text-sm font-semibold">Kecantikan</span>
			</a>
		</nav>
	</section>
}
