package partials

import (
	"gogo/internal/features/home/ui/application/results"
	"gogo/internal/shared/money"
	"gogo.design/system/web/ui"
)

// LiveSearchPrompt is the drawer's idle state. It is shown while the shopper is
// not yet past the search minimum (empty or too short a term), before any round
// trip: a trigram index cannot answer a one- or two-letter query, so the drawer
// invites a longer term rather than firing a request that cannot be served.
templ LiveSearchPrompt(term string) {
	<div class="px-4 py-8 text-center text-sm text-base-content/60">
		if term == "" {
			Mulai mengetik untuk mencari produk
		} else {
			Terus mengetik — minimal 3 huruf untuk mencari
		}
	</div>
}

// LiveSearchUnavailable is the drawer's degradation state when the platform's
// search projection cannot be reached. The shopper typed a search, not a fault,
// so the drawer stays quiet and useful rather than surfacing an error page.
templ LiveSearchUnavailable() {
	<div class="px-4 py-8 text-center text-sm text-base-content/60">
		Pencarian sedang tidak tersedia. Coba lagi sebentar.
	</div>
}

// LiveSearchResults is the drawer's result list, rendered by the home page's
// live-search endpoint as the shopper types. Each row carries the product's
// resolved primary image (or the fallback icon) and links to the product detail
// page; clicking one closes the drawer, which the LiveSearchJS keyboard helper
// on the shell scripts wires up.
templ LiveSearchResults(products []*results.Product, term string) {
	<div class="flex flex-col gap-1 p-2">
		for _, product := range products {
			<a
				href={ "/catalog/" + product.ID }
				data-search-result
				class="flex items-center gap-3 rounded-xl px-3 py-2 transition-colors hover:bg-base-200/70 focus-visible:bg-base-200/70"
			>
				if product.ImageURL != "" {
					<img src={ product.ImageURL } alt={ product.Name } loading="lazy" class="h-11 w-11 shrink-0 rounded-lg object-cover" />
				} else {
					<span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-base-200 text-base-content/50">
						@ui.IconTag("size-5")
					</span>
				}
				<span class="min-w-0 flex-1">
					<span class="block truncate text-sm font-medium text-base-content">
						{ product.Name }
					</span>
					<span class="block text-xs text-base-content/50">
						{ product.Brand }
					</span>
				</span>
				@ui.PriceBlock("Rp", money.Rupiah(product.Price), ui.PriceSm)
			</a>
		}
		if len(products) == 0 {
			<div class="px-4 py-8 text-center text-sm text-base-content/60">
				<span>Tidak ada hasil untuk “{ term }”. Coba kata lain.</span>
			</div>
		}
	</div>
}
