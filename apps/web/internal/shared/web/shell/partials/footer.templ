package partials

import (
	"gogo/internal/shared/web/site"
	"gogo.design/system/web/ui"
)

templ Footer() {
	{{ siteSettings := site.FromContext(ctx) }}
	<footer class="border-t border-base-300/60 bg-base-100/70 py-6 backdrop-blur-sm">
		<div class="container mx-auto flex flex-col items-center justify-between gap-3 px-4 sm:flex-row">
			if siteSettings.FooterText != "" {
				<p class={ ui.SmallMutedClass + " font-medium" }>
					{ siteSettings.FooterText }
				</p>
			}

			if len(siteSettings.FooterLinks) > 0 {
				<nav aria-label="Tautan footer">
					<ul class="flex flex-wrap items-center justify-center gap-1.5">
						for _, link := range siteSettings.FooterLinks {
							<li>
								<a class="link link-hover text-sm" href={ link.Href }>{ link.Label }</a>
							</li>
						}
					</ul>
				</nav>
			} else {
				<ul class="flex flex-wrap items-center justify-center gap-1.5" aria-label="Dibangun dengan">
					for _, tech := range []string{"Go", "Chi", "Templ", "HTMX", "Tailwind", "DaisyUI"} {
						<li>
							@ui.Badge("neutral badge-soft", "sm", "font-medium text-xs") {
								{ tech }
							}
						</li>
					}
				</ul>
			}
		</div>
	</footer>
}
