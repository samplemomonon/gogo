# Source control
.git
.gitignore

# Build output / generated artifacts (regenerated inside the image)
bin/
_build/
coverage/
apps/web/internal/shared/web/assets/css/output.css

# local env files (may contain secrets)
.env
.env.*
!.env.example

# Toolchain artifacts (dev only)
# .devenv matters here, not just for tidiness: the Dockerfile runs `COPY . .`
# in two stages, so an unignored .devenv ships the whole Go module cache to
# the Docker daemon as build context on every build.
node_modules/
**/node_modules/
.devenv/
**/.devenv/
.nix-devenv

# Editor cruft
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
tmp/
