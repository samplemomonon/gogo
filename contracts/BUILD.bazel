# gazelle:prefix gogo/contracts
#
# This directory is its own Go module, so it needs its own prefix directive rather
# than inheriting gogo's. proto/ holds the .proto sources that buf compiles into the
# sibling <name>/v1 packages; -proto=disable in the root Gazelle rule keeps those
# directories rule-free.

# go.mod is referenced by name from the root go.work, and go.work is the file the
# go_deps extension in MODULE.bazel reads, so go.mod has to be a visible file target.
exports_files(["go.mod"])
