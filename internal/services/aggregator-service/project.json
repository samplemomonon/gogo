{
  "name": "aggregator-service",
  "$schema": "{NX_ROOT}/node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "aggregator-service/cmd",
  "tags": [
    "tier:composition",
    "type:app",
    "lang:go",
    "scope:catalogue"
  ],
  "implicitDependencies": [
    "category-service",
    "media-service",
    "product-listing-service",
    "product-search-service",
    "product-service"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aggregator-service",
        "commands": [
          {
            "command": "go build ./..."
          }
        ]
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aggregator-service",
        "commands": [
          {
            "command": "mkdir -p bin && go build -trimpath -o bin/aggregator-service ./cmd/server"
          }
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aggregator-service",
        "commands": [
          {
            "command": "go test ./..."
          }
        ],
        "env": {
          "CGO_ENABLED": "0"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aggregator-service",
        "commands": [
          {
            "command": "unformatted=$(gofmt -l .); if [ -n \"$unformatted\" ]; then echo \"not gofmt-clean:\"; echo \"$unformatted\"; exit 1; fi"
          },
          {
            "command": "go vet ./..."
          }
        ],
        "env": {}
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aggregator-service",
        "commands": [
          {
            "command": "gofmt -w ."
          }
        ],
        "env": {}
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aggregator-service",
        "commands": [
          {
            "command": "unformatted=$(gofmt -l .); if [ -n \"$unformatted\" ]; then echo \"not gofmt-clean:\"; echo \"$unformatted\"; exit 1; fi"
          }
        ],
        "env": {}
      }
    },
    "tidy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aggregator-service",
        "commands": [
          {
            "command": "go mod tidy"
          }
        ],
        "env": {}
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aggregator-service",
        "commands": [
          {
            "command": "go run ./cmd/server"
          }
        ],
        "env": {}
      }
    },
    "docker:build": {
      "executor": "./tools/nx-platform:run-tool",
      "options": {
        "tool": "docker",
        "command": "docker compose build",
        "cwd": "aggregator-service",
        "label": "docker compose build"
      }
    },
    "docker:up": {
      "executor": "./tools/nx-platform:run-tool",
      "options": {
        "tool": "docker",
        "command": "docker compose up -d --build",
        "cwd": "aggregator-service",
        "label": "docker compose up"
      }
    },
    "docker:down": {
      "executor": "./tools/nx-platform:run-tool",
      "options": {
        "tool": "docker",
        "command": "docker compose down",
        "cwd": "aggregator-service",
        "label": "docker compose down"
      }
    },
    "docker:logs": {
      "executor": "./tools/nx-platform:run-tool",
      "options": {
        "tool": "docker",
        "command": "docker compose logs -f --tail=100",
        "cwd": "aggregator-service",
        "label": "docker compose logs"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aggregator-service",
        "commands": [
          {
            "command": "bash hack/gen.sh"
          }
        ],
        "env": {}
      }
    },
    "ci": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aggregator-service",
        "commands": [
          {
            "command": "go vet ./... && go test ./... && go build ./..."
          }
        ],
        "env": {}
      }
    }
  }
}
