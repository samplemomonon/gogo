package pages

import (
	"gogo/internal/pages/profile/application/results"
	"gogo/internal/shared/web/navigation"
	"gogo/internal/shared/web/shell/layouts"
	"gogo/internal/shared/web/ui"
)

// Section names one account area the profile sidebar navigates between. Each
// section is its own route, so the sidebar highlights the active one through
// the same path rule the shell uses.
type Section string

const (
	SectionOverview  Section = "ringkasan"
	SectionOrders    Section = "pesanan"
	SectionAddresses Section = "alamat"
	SectionSettings  Section = "pengaturan"
)

// profileNav is the account sidebar, in order. It mirrors the seller console's
// sidebar layout so both consoles read as the same place.
var profileNav = []ui.NavItem{
	{Href: "/profile", Label: "Ringkasan", Icon: ui.IconUser("size-4")},
	{Href: "/profile/pesanan", Label: "Pesanan", Icon: ui.IconCart("size-4")},
	{Href: "/profile/alamat", Label: "Alamat", Icon: ui.IconHome("size-4")},
	{Href: "/profile/pengaturan", Label: "Pengaturan", Icon: ui.IconDocument("size-4")},
}

// sectionLabel maps a section to its sidebar label, so a route path resolves to
// the same label the sidebar renders.
func sectionLabel(s Section) string {
	switch s {
	case SectionOrders:
		return "Pesanan"
	case SectionAddresses:
		return "Alamat"
	case SectionSettings:
		return "Pengaturan"
	default:
		return "Ringkasan"
	}
}

// SectionFor maps a request path to the account section it renders, defaulting
// to the overview for the bare /profile route.
func SectionFor(path string) Section {
	switch path {
	case "/profile/pesanan":
		return SectionOrders
	case "/profile/alamat":
		return SectionAddresses
	case "/profile/pengaturan":
		return SectionSettings
	default:
		return SectionOverview
	}
}

// SidebarInsetClass sizes the account console's content column. It deliberately
// does NOT restate the shell's `container mx-auto px-4 py-8`: layouts.Base
// already wraps every page body in one, so repeating it here nested a second
// max-width container and a second 1rem gutter inside the first.
const SidebarInsetClass = "gap-6"

// Profile is the storefront account page: a sidebar of account areas beside the
// active section's content, using the same SidebarProvider layout as the seller
// console. account is nil for a signed-out visitor, in which case the page still
// renders — with a sign-in prompt instead of the account header — so the seller
// console link stays reachable.
templ Profile(account *results.Account, section Section) {
	@layouts.Base(pageTitle(section), navigation.NavFromContext(ctx), navigation.PathFromContext(ctx), "") {
		@ui.SidebarProvider(ui.SidebarProviderOptions{
			ID:      "profile-sidebar",
			Mode:    ui.SidebarDrawer,
			Sidebar: sidebar(navigation.PathFromContext(ctx)),
			Inset:   sidebarInset(account, section),
		})
	}
}

templ sidebar(path string) {
	@ui.Sidebar(ui.SidebarOptions{
		Header:  sidebarHeader(),
		Content: sidebarGroups(path),
		Footer:  sidebarFooter(),
	})
}

templ sidebarHeader() {
	@ui.SidebarHeader() {
		@ui.BrandLink("/profile", "Akun", "Akun Saya")
	}
}

templ sidebarGroups(path string) {
	@ui.SidebarGroup() {
		@ui.SidebarGroupLabel("Akun saya")
		@ui.SidebarGroupContent() {
			@ui.SidebarMenu(ui.SidebarMenuOptions{Items: profileNav, Path: path})
		}
	}
}

// sidebarFooter carries the direct entry into the seller console, kept out of
// the top bar and reachable from the account page instead. It is the sidebar's
// one primary (blue) action, so it reads as the way out of the account area and
// into the seller console rather than another plain menu item.
templ sidebarFooter() {
	@ui.SidebarFooter() {
		@ui.ButtonLink("/seller", ui.TapActionClass(ui.IntentPrimary, "sm")+" w-full", nil) {
			@ui.IconStore("size-4")
			Konsol Seller
		}
	}
}

templ sidebarInset(account *results.Account, section Section) {
	@ui.SidebarInset(ui.SidebarInsetOptions{ID: "profile-sidebar", Mode: ui.SidebarDrawer, Class: SidebarInsetClass}) {
		@sectionContent(account, section)
	}
}

templ sectionContent(account *results.Account, section Section) {
	switch section {
	case SectionOrders:
		@OrdersSection()
	case SectionAddresses:
		@AddressesSection()
	case SectionSettings:
		@SettingsSection(account)
	default:
		@OverviewSection(account)
	}
}

templ OverviewSection(account *results.Account) {
	if account != nil {
		@AccountHero(account)
	} else {
		@GuestHero()
	}

	<div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
		@ui.Panel("Pesanan") {
			@ui.EmptyState("Belum ada pesanan", "Riwayat pesanan Anda akan muncul di sini setelah Anda berbelanja.", ui.IconCart("size-7")) {
				@ui.ButtonLink("/", ui.TapActionClass(ui.IntentPrimary, "sm"), nil) {
					@ui.IconSearch("size-4")
					Mulai belanja
				}
			}
		}

		@ui.Panel("Alamat pengiriman") {
			@ui.EmptyState("Belum ada alamat", "Tambahkan alamat pengiriman untuk mempercepat checkout.", ui.IconHome("size-7"))
		}
	</div>
}

templ OrdersSection() {
	@ui.PageHero("Pesanan", "primary", "Pesanan saya", "Riwayat pembelian dan status pengiriman.", ui.IconCart("size-4"))

	@ui.Panel("Riwayat pesanan") {
		@ui.EmptyState("Belum ada pesanan", "Pesanan yang Anda buat akan muncul di sini.", ui.IconCart("size-7")) {
			@ui.ButtonLink("/", ui.TapActionClass(ui.IntentPrimary, "sm"), nil) {
				@ui.IconSearch("size-4")
				Mulai belanja
			}
		}
	}
}

templ AddressesSection() {
	@ui.PageHero("Alamat", "primary", "Alamat saya", "Kelola alamat pengiriman Anda.", ui.IconHome("size-4"))

	@ui.Panel("Alamat pengiriman") {
		@ui.EmptyState("Belum ada alamat", "Tambahkan alamat pengiriman untuk mempercepat checkout.", ui.IconHome("size-7"))
	}
}

templ SettingsSection(account *results.Account) {
	@ui.PageHero("Pengaturan", "primary", "Pengaturan akun", "Kelola akses dan keamanan akun Anda.", ui.IconDocument("size-4"))

	if account != nil {
		@ui.Panel("Akun") {
			@ui.FactList() {
				@ui.FactRow("Nama", account.Name)
				@ui.FactRow("Email", account.Email)
				@ui.FactRow("Peran", roleLabel(account.Role))
			}
		}
		@ui.Panel("Sesi") {
			@ui.Form(ui.FormOptions{Action: "/logout", Layout: ui.FormStack}) {
				<p class={ ui.SmallMutedClass }>Keluar dari akun ini pada perangkat ini.</p>
				@ui.SubmitAction(ui.IntentPrimary, "sm", "w-full "+ui.TapTargetClass, ui.SubmitAttrs("Keluar dari akun ini?")) {
					@ui.IconArrowLeft("size-4")
					Keluar
				}
			}
		}
	} else {
		@ui.Panel("Masuk") {
			<p class={ ui.SmallMutedClass }>Masuk untuk mengelola pengaturan akun Anda.</p>
			@ui.ButtonLink("/login", ui.TapActionClass(ui.IntentPrimary, "sm")+" w-full", nil) {
				@ui.IconUser("size-4")
				Masuk
			}
		}
	}
}

templ AccountHero(account *results.Account) {
	@ui.PageHero("Ringkasan", "primary", account.Name, account.Email, ui.IconUser("size-4")) {
		@ui.StatTile("Peran", roleLabel(account.Role))
	}
}

templ GuestHero() {
	@ui.PageHero("Ringkasan", "primary", "Belum masuk", "Masuk untuk melihat pesanan, alamat, dan pengaturan akun Anda.", ui.IconUser("size-4")) {
		@ui.ButtonLink("/login", ui.TapActionClass(ui.IntentPrimary, "sm"), nil) {
			@ui.IconUser("size-4")
			Masuk
		}
	}
}

func roleLabel(role string) string {
	switch role {
	case "admin":
		return "Admin"
	case "seller":
		return "Seller"
	case "viewer":
		return "Viewer"
	default:
		return "—"
	}
}

func pageTitle(section Section) string {
	return "Akun — " + sectionLabel(section)
}
