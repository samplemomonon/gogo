    name = "partials",
    srcs = ["seller_templ.go"],
    importpath = "gogo/internal/pages/seller/views/partials",
    visibility = ["//gogo:__subpackages__"],
    deps = [
        "//gogo/internal/pages/seller/application/results",
        "//gogo/internal/shared/money",
        "//gogo/internal/shared/web/ui",
        "@com_github_a_h_templ//:templ",
        "@com_github_a_h_templ//runtime",
    ],
)
