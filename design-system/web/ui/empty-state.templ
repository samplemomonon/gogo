package ui

// EmptyState is the centered icon + title + description shown when a collection
// is empty; the children slot is an optional action. icon may be nil.
templ EmptyState(title string, description string, icon templ.Component) {
	<div class="flex flex-col items-center justify-center py-12 sm:py-16 gap-4 text-center px-4 max-w-md mx-auto">
		if icon != nil {
			<div class="size-16 rounded-2xl bg-gradient-to-b from-base-200 to-base-200/60 border border-base-300/60 shadow-xs flex items-center justify-center text-base-content/40">
				@icon
			</div>
		}
		<div class="space-y-1.5">
			<p class="font-semibold text-base text-base-content">{ title }</p>
			if description != "" {
				<p class={ MutedClass + " text-sm leading-relaxed" }>{ description }</p>
			}
		</div>
		{ children... }
	</div>
}
