templ IconChevronRight(class string) {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class={ class }>
		<path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.17 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.24a.75.75 0 0 1 0 1.08l-4.5 4.24a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd"/>
	</svg>
}

// IconLogo is the brand mark: the "g" tile behind the wordmark in the shell
// header. It inherits currentColor so it follows the link's own hover and focus
// colour rather than carrying a second palette.
templ IconLogo(class string) {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class={ class }>
		<path d="M10 2a8 8 0 1 0 0 16h1.25a.625.625 0 0 0 0-1.25H10a6.75 6.75 0 1 1 6.75-6.75v1.5A2.75 2.75 0 0 1 14 11.5H9.5a.625.625 0 0 0-.47.21l-2.9 3.33a.625.625 0 0 0 .1.92A6.76 6.76 0 0 0 10 16.75c-.28 0-.55-.02-.82-.05l-.3 1.4A8.2 8.2 0 0 0 10 18.25 8.25 8.25 0 0 0 18.25 10 8.25 8.25 0 0 0 10 2Z"/>
	</svg>
}

