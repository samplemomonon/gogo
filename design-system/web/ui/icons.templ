		<path d="M6 6l12 12M18 6L6 18"/>
	</svg>
}

// IconHome, IconStore and IconUser are the shell's destination glyphs: they
// label the canonical nav items in the mobile tab bar and dropdown.
templ IconHome(class string) {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={ class }>
		<path d="M3 10.5 12 3l9 7.5"/>
		<path d="M5.5 9.5V20a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V9.5"/>
		<path d="M9.5 21v-6h5v6"/>
	</svg>
}

templ IconStore(class string) {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={ class }>
		<path d="M3.5 9.5 5 4h14l1.5 5.5"/>
		<path d="M4 9.5h16V20a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1Z"/>
		<path d="M3.5 9.5a2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0"/>
	</svg>
}

templ IconUser(class string) {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={ class }>
		<circle cx="12" cy="8" r="3.5"/>
		<path d="M5.5 20a6.5 6.5 0 0 1 13 0"/>
	</svg>
}

